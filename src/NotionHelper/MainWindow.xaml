<Window x:Class="NotionHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notion Helper" Height="720" Width="560"
        MinHeight="560" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7F5" Foreground="#20211F"
        FontFamily="Segoe UI" FontSize="14"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Notion Helper" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="Local writing and formatting assistant" Foreground="#666A63" Margin="0,3,0,0"/>
        </StackPanel>

        <Expander x:Name="SettingsExpander" Grid.Row="1" Header="Local settings"
                  Margin="0,0,0,12">
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Ollama model" VerticalAlignment="Center" Margin="0,0,12,8"/>
                <TextBox x:Name="ModelNameInput" Grid.Column="1" Grid.ColumnSpan="2"
                         Height="30" Padding="7,4" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Text="Shortcut" VerticalAlignment="Center" Margin="0,0,12,8"/>
                <ComboBox x:Name="ShortcutSelector" Grid.Row="1" Grid.Column="1" SelectedValuePath="Tag"
                          Height="30" Margin="0,0,8,8">
                    <ComboBoxItem Content="Ctrl+Shift+Space" Tag="ControlShiftSpace"/>
                    <ComboBoxItem Content="Ctrl+Alt+Space" Tag="ControlAltSpace"/>
                    <ComboBoxItem Content="Ctrl+Shift+N" Tag="ControlShiftN"/>
                </ComboBox>
                <Button x:Name="SaveSettingsButton" Grid.Row="1" Grid.Column="2"
                        Content="Save" Padding="12,5" Margin="0,0,0,8"
                        Click="SaveSettingsButton_OnClick"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                           Text="Settings are stored locally. Inference remains on 127.0.0.1; no text is saved."
                           Foreground="#666A63" FontSize="12" TextWrapping="Wrap"/>
            </Grid>
        </Expander>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Mode" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ComboBox x:Name="ModeSelector" Grid.Column="1" Height="34" SelectedIndex="0"
                      SelectionChanged="ModeSelector_OnSelectionChanged">
                <ComboBoxItem Content="Proofread only"/>
                <ComboBoxItem Content="Improve structure when useful"/>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Selected text" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <TextBox x:Name="SourceText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Padding="12" Background="White" BorderBrush="#E1E2DE"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Press Ctrl+Shift+Space with text selected in Notion."
                       TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#555A53"/>
            <Button x:Name="ImproveButton" Grid.Column="1" Content="Improve text"
                    Padding="17,9" Margin="14,0,0,0" Background="#252724" Foreground="White"
                    BorderThickness="0" Click="ImproveButton_OnClick"/>
        </Grid>

        <Grid Grid.Row="5" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Preview" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <TextBox x:Name="PreviewText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Padding="12" Background="White" BorderBrush="#E1E2DE"/>
        </Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Runs locally with Ollama. Review before applying."
                       Foreground="#73776F" FontSize="12" VerticalAlignment="Center"/>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Close"
                    Padding="14,8" Margin="8,0,0,0" Click="CloseButton_OnClick"/>
            <Button x:Name="ApplyButton" Grid.Column="2" Content="Apply to Notion"
                    Padding="14,8" Margin="8,0,0,0" IsEnabled="False"
                    Background="#DFEBDD" BorderBrush="#C6D7C2"
                    Click="ApplyButton_OnClick"/>
        </Grid>
    </Grid>
</Window>
